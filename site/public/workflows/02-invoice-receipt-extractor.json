        "simple": false,
        "filters": {
          "q": "has:attachment filename:pdf (invoice OR receipt OR bill)",
          "readStatus": "unread"
        },
        "options": {
          "downloadAttachments": true,
          "dataPropertyAttachmentsPrefixName": "attachment_"
        }
      },
