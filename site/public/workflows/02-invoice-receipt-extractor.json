      "parameters": {
        "text": "=Extract the details of this invoice or receipt.\n\n---\n{{ $json.text }}\n---",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"documentType\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"invoice\",\n        \"receipt\",\n        \"credit_note\",\n        \"other\"\n      ]\n    },\n    \"vendorName\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"vendorTaxNumber\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ],\n      \"description\": \"GST/HST business number, QST number or VAT ID if printed\"\n    },\n    \"invoiceNumber\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"invoiceDate\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ],\n      \"description\": \"YYYY-MM-DD\"\n    },\n    \"dueDate\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ],\n      \"description\": \"YYYY-MM-DD\"\n    },\n    \"currency\": {\n      \"type\": \"string\",\n      \"description\": \"ISO 4217 code, e.g. CAD or USD\"\n    },\n    \"subtotal\": {\n      \"type\": [\n        \"number\",\n        \"null\"\n      ]\n    },\n    \"taxes\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"type\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"GST\",\n              \"HST\",\n              \"PST\",\n              \"QST\",\n              \"VAT\",\n              \"Sales tax\",\n              \"Other\"\n            ]\n          },\n          \"rate\": {\n            \"type\": [\n              \"number\",\n              \"null\"\n            ],\n            \"description\": \"Percent, e.g. 13 for 13%\"\n          },\n          \"amount\": {\n            \"type\": \"number\"\n          }\n        },\n        \"required\": [\n          \"type\",\n          \"amount\"\n        ]\n      }\n    },\n    \"total\": {\n      \"type\": [\n        \"number\",\n        \"null\"\n      ]\n    },\n    \"lineItems\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"description\": {\n            \"type\": \"string\"\n          },\n          \"quantity\": {\n            \"type\": [\n              \"number\",\n              \"null\"\n            ]\n          },\n          \"unitPrice\": {\n            \"type\": [\n              \"number\",\n              \"null\"\n            ]\n          },\n          \"amount\": {\n            \"type\": \"number\"\n          }\n        },\n        \"required\": [\n          \"description\",\n          \"amount\"\n        ]\n      }\n    },\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"software\",\n        \"hardware\",\n        \"travel\",\n        \"meals\",\n        \"office\",\n        \"contractor\",\n        \"marketing\",\n        \"utilities\",\n        \"rent\",\n        \"other\"\n      ]\n    },\n    \"paymentStatus\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"paid\",\n        \"due\",\n        \"overdue\",\n        \"unknown\"\n      ]\n    }\n  },\n  \"required\": [\n    \"documentType\",\n    \"vendorName\",\n    \"invoiceDate\",\n    \"currency\",\n    \"subtotal\",\n    \"taxes\",\n    \"total\",\n    \"lineItems\",\n    \"category\",\n    \"paymentStatus\"\n  ]\n}",
        "options": {
          "systemPromptTemplate": "You are an accounts-payable assistant for a Canadian small business.\nExtract only what is printed on the document — never guess. Use null for missing values.\nDates must be YYYY-MM-DD. Amounts are plain numbers without currency symbols.\nList each sales tax separately (GST, HST, PST, QST) with its rate when shown.\nPick the closest spend category."
        }
      },
