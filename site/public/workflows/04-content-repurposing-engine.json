      "name": "Gemini 3.6 Flash",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        1520,
        460
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"headline\": {\n      \"type\": \"string\"\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"Two sentences\"\n    },\n    \"linkedinPost\": {\n      \"type\": \"string\"\n    },\n    \"xThread\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"newsletterBlurb\": {\n      \"type\": \"string\"\n    },\n    \"instagramCaption\": {\n      \"type\": \"string\"\n    },\n    \"hooks\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"hashtags\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"keyTakeaways\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"headline\",\n    \"summary\",\n    \"linkedinPost\",\n    \"xThread\",\n    \"newsletterBlurb\",\n    \"instagramCaption\",\n    \"hooks\",\n    \"hashtags\",\n    \"keyTakeaways\"\n  ],\n  \"additionalProperties\": false\n}"
      },
