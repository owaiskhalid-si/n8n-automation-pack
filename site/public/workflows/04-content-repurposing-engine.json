      "id": "4ac18d77-7dea-559b-ae53-e6be0df88a6a",
      "name": "Source content",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1340,
        240
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Audience: {{ $json.audience }}\nTone: {{ $json.tone }}\n{{ $json.brand ? 'Brand: ' + $json.brand : '' }}\nTitle: {{ $json.title || 'n/a' }}\n\nSource:\n\"\"\"\n{{ $json.content }}\n\"\"\"",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "You are a senior content strategist and copywriter. Repurpose the source into native content for each channel.\n\nRules:\n- Keep every claim faithful to the source. Do not invent statistics, quotes or results.\n- LinkedIn: strong first line, short paragraphs, one idea, a soft CTA, 120–220 words, max 3 emojis.\n- X thread: 4–7 posts, each under 270 characters, first post is the hook, number them like 1/.\n- Newsletter blurb: 60–90 words that make people click.\n- Instagram caption: conversational, line breaks, up to 5 relevant hashtags at the end.\n- Hooks: 3 alternative opening lines with different angles (contrarian, story, data)."
            }
          ]
        }
      },
