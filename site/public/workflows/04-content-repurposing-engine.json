        "extractionValues": {
          "values": [
            {
              "key": "title",
              "cssSelector": "title",
              "returnValue": "text"
            },
            {
              "key": "body",
              "cssSelector": "article, main, body",
              "returnValue": "text",
              "skipSelectors": "nav, header, footer, script, style, aside, form, noscript"
            }
          ]
        },
        "options": {
          "trimValues": true,
          "cleanUpText": true
        }
      },
