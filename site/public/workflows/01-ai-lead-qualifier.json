              "value": "={{ $json.body.website || '' }}",
              "type": "string"
            },
            {
              "id": "3fedd8f3-022a-5094-a087-9b31964b9cde",
              "name": "role",
              "value": "={{ $json.body.role || '' }}",
              "type": "string"
            },
            {
