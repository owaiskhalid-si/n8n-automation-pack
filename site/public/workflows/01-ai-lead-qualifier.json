      "id": "22d26d3e-4d72-5814-a9d0-263413b0cd3a",
      "name": "Normalize lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        260
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Qualify this inbound lead.\n\nName: {{ $json.name }}\nEmail: {{ $json.email }}\nCompany: {{ $json.company }}\nWebsite: {{ $json.website }}\nRole: {{ $json.role }}\nBudget: {{ $json.budget }}\nTimeline: {{ $json.timeline }}\nSource: {{ $json.source }}\nMessage:\n\"\"\"\n{{ $json.message }}\n\"\"\"",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "You are a senior sales development rep for a software studio that builds web apps, mobile apps, CRMs, booking systems and AI automations for small and mid-sized businesses in North America.\n\nIdeal customer profile:\n- A business with a clear problem that software or automation can solve\n- Budget of CA$5,000+ for a project, or a monthly retainer\n- Decision maker or strong influencer (founder, owner, director, head of operations)\n- Wants to start within the next 3 months\n\nScore the lead 0–100 against this profile. Be calibrated — most leads are warm, few are hot.\n- hot (70–100): strong fit, clear need, budget and authority\n- warm (40–69): some fit, but budget, authority or timeline is unclear\n- cold (0–39): poor fit, spam, students, job seekers, vague requests\n\nWrite the reply draft in the lead's language: friendly, specific to their message, under 120 words, ending with one clear next step. Never invent facts about the lead."
            }
          ]
        }
      },
      "id": "6804f6a7-850e-5b3b-a189-eace724bf1e8",
      "name": "Qualify lead",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        460,
        260
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.5-flash-lite",
        "options": {
          "temperature": 0.2,
          "maxOutputTokens": 8192
        }
      },
      "id": "f046e182-14bf-583e-a19b-e8851b5e11d7",
      "name": "Gemini 3.5 Flash-Lite",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        400,
        480
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"score\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"maximum\": 100\n    },\n    \"tier\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"hot\",\n        \"warm\",\n        \"cold\"\n      ]\n    },\n    \"intent\": {\n      \"type\": \"string\",\n      \"description\": \"One sentence: what the lead wants\"\n    },\n    \"servicesNeeded\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"budgetFit\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"strong\",\n        \"possible\",\n        \"weak\",\n        \"unknown\"\n      ]\n    },\n    \"isDecisionMaker\": {\n      \"type\": \"boolean\"\n    },\n    \"reasons\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"2–4 short reasons for the score\"\n    },\n    \"nextAction\": {\n      \"type\": \"string\"\n    },\n    \"replyDraft\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"score\",\n    \"tier\",\n    \"intent\",\n    \"servicesNeeded\",\n    \"budgetFit\",\n    \"isDecisionMaker\",\n    \"reasons\",\n    \"nextAction\",\n    \"replyDraft\"\n  ],\n  \"additionalProperties\": false\n}"
      },
