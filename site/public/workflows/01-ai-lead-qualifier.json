              "name": "budget",
              "value": "={{ $json.body.budget || 'Not specified' }}",
              "type": "string"
            },
            {
              "id": "3da220d8-b38c-58be-a686-9eb8e4d1e57c",
              "name": "timeline",
              "value": "={{ $json.body.timeline || 'Not specified' }}",
              "type": "string"
            },
            {
              "id": "e2d2b4d9-631a-540c-a11e-2b817dc02555",
              "name": "message",
              "value": "={{ String($json.body.message || '').slice(0, 4000) }}",
              "type": "string"
            },
            {
              "id": "53c13d37-e9f1-50fc-a260-a585cf2fa539",
              "name": "source",
              "value": "={{ $json.body.source || 'website' }}",
              "type": "string"
            },
            {
