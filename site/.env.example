# Base URL of your n8n instance. Leave empty to serve recorded sample responses.
N8N_WEBHOOK_BASE=https://n8n.example.com
# Value of the "Demo gateway key" header credential (sent as X-Demo-Key) when webhooks are protected.
N8N_DEMO_KEY=

NEXT_PUBLIC_SITE_URL=https://flowbench.example.com
NEXT_PUBLIC_REPO_URL=
NEXT_PUBLIC_AUTHOR_NAME=
NEXT_PUBLIC_AUTHOR_URL=
