# Public hostname pointing at this server (A record → the VM's public IP, or <ip>.sslip.io)
N8N_DOMAIN=n8n.example.com
# Let's Encrypt registration email
ACME_EMAIL=you@example.com

# Generate with: openssl rand -hex 32
# (infra/oracle/setup.sh generates these; the Terraform bootstrap fills them from SSM Parameter Store)
N8N_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

TIMEZONE=America/Toronto
N8N_VERSION=2.40.7

# Space-separated CIDRs allowed to open the editor (webhooks stay public)
EDITOR_ALLOWED_IPS=0.0.0.0/0 ::/0

# Nightly backups: always kept locally with rotation…
BACKUP_DIR=/var/backups/n8n
BACKUP_KEEP=14
# …and also copied to S3 when a bucket is set (AWS/Terraform deployments)
BACKUP_BUCKET=
