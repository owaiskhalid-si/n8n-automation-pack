      "id": "79c97185-6794-5017-aba7-6145f49fa880",
      "name": "Normalize email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        240
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=From: {{ $json.fromName }} <{{ $json.from }}>\nSubject: {{ $json.subject }}\n\n\"\"\"\n{{ $json.body }}\n\"\"\"",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "You are the head of customer support for a B2B SaaS company. Triage each incoming email.\n\nUrgency rubric:\n- critical: outage, data loss, security issue, or payment taken in error\n- high: customer blocked from core work, or threatening to cancel\n- normal: questions and non-blocking problems\n- low: feedback, feature ideas, newsletters\n\nneedsHuman is true for refunds, legal or security topics, angry customers, and anything you are unsure about.\n\nReply draft: warm, concise (under 130 words), acknowledge the specific problem, give the next step. Never promise refunds, credits or dates. Sign off as “The Support Team”. Leave suggestedReply empty for spam."
            }
          ]
        }
      },
      "id": "0c326965-4818-53f3-a473-899818f4262d",
      "name": "Triage email",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        720,
        240
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.5-flash-lite",
        "options": {
          "temperature": 0.2,
          "maxOutputTokens": 8192
        }
      },
      "id": "4b6ffc02-9d3e-5bdc-a5dc-a999285d3765",
      "name": "Gemini 3.5 Flash-Lite",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        660,
        460
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"billing\",\n        \"bug_report\",\n        \"account_access\",\n        \"feature_request\",\n        \"sales_inquiry\",\n        \"cancellation\",\n        \"spam\",\n        \"other\"\n      ]\n    },\n    \"urgency\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"low\",\n        \"normal\",\n        \"high\",\n        \"critical\"\n      ]\n    },\n    \"sentiment\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"positive\",\n        \"neutral\",\n        \"negative\",\n        \"angry\"\n      ]\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"One sentence\"\n    },\n    \"customerGoal\": {\n      \"type\": \"string\"\n    },\n    \"language\": {\n      \"type\": \"string\",\n      \"description\": \"ISO 639-1 code\"\n    },\n    \"needsHuman\": {\n      \"type\": \"boolean\"\n    },\n    \"tags\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"suggestedReply\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"category\",\n    \"urgency\",\n    \"sentiment\",\n    \"summary\",\n    \"customerGoal\",\n    \"language\",\n    \"needsHuman\",\n    \"tags\",\n    \"suggestedReply\"\n  ],\n  \"additionalProperties\": false\n}"
      },
      "id": "0b41b249-44c4-54bf-aaf7-4626de8b36fb",
