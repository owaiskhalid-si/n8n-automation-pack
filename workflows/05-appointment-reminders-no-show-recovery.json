        "method": "PATCH",
        "url": "={{ $('Config').first().json.bookingApiUrl }}/appointments/{{ $('Pick reminders due').item.json.appointmentId }}/reminders",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { type: $('Pick reminders due').item.json.reminderType, sentAt: $now.toISO() } }}",
        "options": {}
      },
      "id": "eb5a904e-aabc-5ff8-a4c4-2c3ec3215265",
      "name": "Mark reminder sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1360,
        60
      ]
    },
    {
      "parameters": {
        "content": "## 2 · No-show recovery\nYour booking system calls this webhook when an appointment is marked **no-show**. Gemini writes a warm, non-judgemental rebooking message (SMS + email versions) and Twilio sends it.\n\n`POST { customerName, service, missedAt, rebookUrl, businessName, phone }`",
        "height": 260,
        "width": 440,
        "color": 5
      },
      "id": "0c061c54-98b8-5874-a716-b8fb1b5a49b3",
      "name": "Note 2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -480,
        420
      ]
    },
