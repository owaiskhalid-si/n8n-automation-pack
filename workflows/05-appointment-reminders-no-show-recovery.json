    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Customer: {{ $json.customerName }} (first name {{ $json.firstName }}, {{ $json.visits }} previous visits)\nMissed: {{ $json.service }} at {{ $json.businessName }}, {{ DateTime.fromISO($json.missedAt).toFormat('cccc LLL d, h:mm a') }}\nRebooking link: {{ $json.rebookUrl }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "You write short, human messages for a local service business after a customer misses an appointment.\nTone: warm, zero guilt, assume life got in the way. Make rebooking effortless.\n- sms: under 300 characters, first name, one link, no emojis beyond one\n- emailSubject: under 60 characters\n- emailBody: 3 short paragraphs, sign off with the business name\nLoyal customers (3+ previous visits) get a slightly more personal note."
            }
          ]
        }
      },
