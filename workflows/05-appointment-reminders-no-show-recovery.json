{
  "id": "kvHlmOaORMbDhabs",
  "name": "Appointment Reminders & No-show Recovery",
  "nodes": [
    {
      "parameters": {
        "content": "## 1 · Appointment reminders (every 15 min)\nPulls confirmed appointments for the next 25 hours from your booking API, picks the ones due a **24h** or **2h** reminder, sends SMS (Twilio) or email, then marks them as sent so nobody is messaged twice.\n\n**Booking API contract**\n`GET /appointments?from&to` → `[{ id, customerName, phone, email, service, staffName, startsAt, status, reminder24hSentAt, reminder2hSentAt }]`\n`PATCH /appointments/:id/reminders` → `{ type, sentAt }`\n\nEdit business name, timezone and URLs in **Config**.",
        "height": 400,
        "width": 440,
        "color": 4
      },
      "id": "03576a75-e1ed-5ebb-a251-b38308ea044e",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -480,
        -120
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "80e5bf10-b7dd-575c-a0c2-d41e37e0cb0d",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        60
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "6864ce51-ce9c-57af-ae6a-e6a6f284ad15",
              "name": "businessName",
              "value": "Maple Dental",
              "type": "string"
            },
            {
              "id": "15eaf23f-bd03-5a06-ab6c-aad484a46212",
              "name": "timezone",
              "value": "America/Toronto",
              "type": "string"
            },
            {
              "id": "7f4dbf37-f102-56fd-a1eb-a78031bf0c68",
              "name": "bookingApiUrl",
              "value": "https://your-booking-app.example.com/api",
              "type": "string"
            },
            {
              "id": "0f456151-061d-5834-ae01-4fc972eebb46",
              "name": "manageUrl",
              "value": "https://your-booking-app.example.com/manage",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "0c839e08-8338-5f96-ab39-ce6f0ca01b18",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        60
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.bookingApiUrl }}/appointments",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "from",
              "value": "={{ $now.toISO() }}"
            },
            {
              "name": "to",
              "value": "={{ $now.plus({ hours: 25 }).toISO() }}"
            },
            {
              "name": "status",
              "value": "confirmed"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "ee5604f4-a4fa-5a0e-aead-0037d3936a4c",
      "name": "Fetch upcoming appointments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        60
      ]
    },
    {
      "parameters": {
        "jsCode": "// Decide which appointments need a 24-hour or 2-hour reminder right now.\nconst config = $('Config').first().json;\nconst now = DateTime.now();\nconst out = [];\n\nfor (const { json: appt } of $input.all()) {\n  if (appt.status && appt.status !== 'confirmed') continue;\n  const startsAt = DateTime.fromISO(appt.startsAt);\n  const hoursUntil = startsAt.diff(now, 'hours').hours;\n  let reminderType = null;\n  if (hoursUntil > 0 && hoursUntil <= 2 && !appt.reminder2hSentAt) reminderType = '2h';\n  else if (hoursUntil > 2 && hoursUntil <= 24 && !appt.reminder24hSentAt) reminderType = '24h';\n  if (!reminderType) continue;\n\n  const when = startsAt.setZone(config.timezone).toFormat(\"cccc, LLL d 'at' h:mm a\");\n  const first = String(appt.customerName || '').split(' ')[0] || 'there';\n  const message = reminderType === '24h'\n    ? `Hi ${first}, a reminder of your ${appt.service} with ${appt.staffName} at ${config.businessName} on ${when}. Need to change it? ${config.manageUrl}/${appt.id}`\n    : `Hi ${first}, see you soon! Your ${appt.service} at ${config.businessName} starts at ${startsAt.setZone(config.timezone).toFormat('h:mm a')}.`;\n\n  out.push({\n    json: {\n      appointmentId: appt.id,\n      reminderType,\n      channel: appt.phone ? 'sms' : 'email',\n      phone: appt.phone,\n      email: appt.email,\n      customerName: appt.customerName,\n      subject: `Reminder: ${appt.service} ${reminderType === '24h' ? 'tomorrow' : 'today'}`,\n      message,\n    },\n  });\n}\nreturn out;"
      },
      "id": "0523fa31-e237-5a8a-a575-f9c7b0fba249",
      "name": "Pick reminders due",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
